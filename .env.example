# Copy to .env.local and fill in. Never commit .env.local.
# Supabase project URL and secret key (Project Settings -> API keys).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Public address of the site, used for canonical links, share images and email links.
NEXT_PUBLIC_SITE_URL=https://whyvote.ng

# Pledge emails, sent through Resend (resend.com). Without these, pledges still save but no email is sent.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM="whyVote <hello@whyvote.ng>"
# Optional: signs unsubscribe links. Falls back to SUPABASE_SECRET_KEY.
EMAIL_SIGNING_SECRET=
